{
  "name": "lumen-academy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:migrate": "pnpm --filter @lumen/server db:migrate",
    "models:check": "pnpm --filter @lumen/server models:check",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"pnpm --filter @lumen/server dev\" \"pnpm --filter @lumen/client dev\"",
    "test:e2e": "playwright test",
    "cli:ingest": "pnpm --filter @lumen/server cli:ingest",
    "cli:curriculum": "pnpm --filter @lumen/server cli:curriculum",
    "cli:register": "pnpm --filter @lumen/server cli:register",
    "eval:agents": "pnpm --filter @lumen/server eval:agents"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
